@* Conventional pattern: subscribe to change events, re-render the container from any thread. *@
@implements IDisposable
@inject RenderProbe Probe
@{
    using var probe = Probe.Render();
}
@foreach (var cell in Cells)
{
    <ClassicCell Cell="cell" />
}

@code {
    [Parameter, EditorRequired]
    public ClassicCellState[] Cells { get; set; } = [];

    protected override void OnInitialized()
    {
        foreach (var cell in Cells)
        {
            cell.Changed += OnCellChanged;
        }
    }

    private void OnCellChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        foreach (var cell in Cells)
        {
            cell.Changed -= OnCellChanged;
        }
    }
}
