<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Fine-grained reactive state for .NET: tracked properties, collections, derived values and effects. Includes the [ReactiveState] source generator.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wick.Blazor" />
    <InternalsVisibleTo Include="Wick.Core.Tests" />
    <InternalsVisibleTo Include="Wick.Blazor.Tests" />
  </ItemGroup>

  <!-- The source generator ships inside this package (analyzers/dotnet/cs); Core does not use it itself. -->
  <ItemGroup>
    <ProjectReference Include="..\Wick.Generators\Wick.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeGeneratorInPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="IncludeGeneratorInPackage">
    <MSBuild Projects="..\Wick.Generators\Wick.Generators.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_ReactiveGeneratorAssembly" />
    </MSBuild>

    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_ReactiveGeneratorAssembly)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
