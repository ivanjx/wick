<header>Blazor in a BlazorWebView</header>
<main>
    <h1>One state, two UI stacks <RenderCount Value="++_renders" /></h1>
    <p class="lead">
        The native controls on the left and these cards read the same <code>CounterState</code>. A write from
        either side, or from the background timer, re-renders only the cards that read what changed.
    </p>

    <div class="cards">
        <CountCard />
        <ParityCard />
        <BatchCard />
        <LogCard />
    </div>
</main>

@code {
    private int _renders;
}
