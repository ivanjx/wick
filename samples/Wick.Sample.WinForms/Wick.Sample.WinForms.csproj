<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- CI builds the solution on Linux, which needs this to restore the Windows Desktop targeting pack. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="10.0.130" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wick.Blazor\Wick.Blazor.csproj" />
    <!-- Package consumers get the generator from the Wick.Core package. -->
    <ProjectReference Include="..\..\src\Wick.Generators\Wick.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The WebView2 package references its WPF control even in WinForms apps; that assembly needs WPF's
       WindowsBase, which conflicts with the WinForms one (MSB3277). The app never loads it. -->
  <Target Name="RemoveWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
